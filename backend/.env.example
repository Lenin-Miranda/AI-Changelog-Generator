# OpenAI
OPENAI_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Server
PORT=3001

# CORS — the frontend origin allowed to call this API
FRONTEND_URL=http://localhost:3000

# Shared database quotas per rolling 24 hours (failed/cancelled attempts count).
GENERATION_USER_DAILY_LIMIT=10
GENERATION_GLOBAL_DAILY_LIMIT=100

# Set only to the verified number of trusted reverse proxies in deployment.
# Keep 0 for direct local access; never trust arbitrary forwarded client headers.
TRUST_PROXY_HOPS=0
