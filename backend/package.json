    "@supabase/supabase-js": "^2.45.4",
    "axios": "^1.7.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "openai": "^4.67.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.16.10",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.1"
