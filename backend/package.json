{
  "name": "ai-changelog-backend",
  "version": "0.1.0",
  "description": "NestJS backend for AI Changelog Generator",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
